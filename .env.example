# PostgreSQL
POSTGRES_DB=news_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Crawler (Crawl4AI) - site được khai báo trong config/sites.yaml
# Rỗng = mọi site enabled; hoặc liệt kê key: cafef,vietstock,tinnhanhchungkhoan,nguoiquansat
CRAWL_SITES=
CRAWL_PAGES=1
CRAWL_MAX_ARTICLES=30
CRAWL_CONCURRENCY=3
# Khi lọc theo ngày (--today / --date / --from): giới hạn số trang listing mỗi chuyên mục
CRAWL_MAX_PAGES=50
# Chu kỳ (phút) của service crawler khi `docker compose up -d`; bài đã có URL trong DB sẽ bỏ qua.
# Phải > 0 vì service để restart: unless-stopped.
CRAWL_INTERVAL_MINUTES=10
